      "id": "7c071083-3300-46b1-8ecc-bf093c8eed48",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Merge metrics + AI summary safely\nconst metrics = items.find(i => i.json.weekly_health_score)?.json || {};\nconst ai = items.find(i => i.json.ai_summary)?.json || {};\n\nconst report = { ...metrics, ...ai };\n\n// Helpers\nconst tableRows = (arr, cols) =>\n  (arr || []).map(r =>\n    `<tr>${cols.map(c => `<td>${r[c] ?? '—'}</td>`).join('')}</tr>`\n  ).join('');\n\nconst avg = (arr, key) =>\n  arr && arr.length\n    ? Math.round(arr.reduce((a,b) => a + b[key], 0) / arr.length)\n    : '—';\n\n// HTML\nconst html = `\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: Inter, Arial, sans-serif; margin: 40px; color: #1f2937; }\nh1, h2 { color: #111827; }\n.cover { page-break-after: always; }\n\n.kpis { display: flex; gap: 24px; margin: 20px 0; }\n.kpi { padding: 16px; border-radius: 12px; background: #f3f4f6; width: 220px; }\n.kpi-value { font-size: 32px; font-weight: bold; }\n\n.section {\n  page-break-inside: avoid;\n  break-inside: avoid;\n  margin-bottom: 40px;\n}\n\n.page-break {\n  page-break-after: always;\n  break-after: page;\n}\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n  margin-top: 12px;\n}\nth, td {\n  border-bottom: 1px solid #e5e7eb;\n  padding: 8px;\n  text-align: left;\n}\nth { background: #f9fafb; }\n\n.ai-box {\n  background: #eef2ff;\n  padding: 20px;\n  border-radius: 12px;\n  margin-top: 24px;\n}\n\n.muted { color: #6b7280; }\n</style>\n</head>\n\n<body>\n\n<!-- COVER PAGE -->\n<div class=\"cover\">\n  <h1>Weekly Health Report</h1>\n\n  <div class=\"kpis\">\n    <div class=\"kpi\">\n      <div class=\"muted\">Health Score</div>\n      <div class=\"kpi-value\">${report.weekly_health_score ?? '—'}</div>\n    </div>\n\n    <div class=\"kpi\">\n      <div class=\"muted\">Weekend Recovery Bonus</div>\n      <div class=\"kpi-value\">${report.weekend_recovery_bonus ?? '—'}</div>\n    </div>\n\n    <div class=\"kpi\">\n      <div class=\"muted\">Avg Sleep Efficiency</div>\n      <div class=\"kpi-value\">${avg(report.Sleep_Eff, 'sleep_efficiency_pct')}%</div>\n    </div>\n  </div>\n\n  <div class=\"ai-box\">\n    <h2>AI Summary</h2>\n    <p>${(report.ai_summary || 'No summary available').replace(/\\n/g,'<br>')}</p>\n  </div>\n</div>\n\n<!-- PAGE 2 -->\n<div class=\"section\">\n  <h2>Sleep Efficiency</h2>\n  <table>\n    <tr><th>Day</th><th>Date</th><th>Efficiency (%)</th></tr>\n    ${tableRows(report.Sleep_Eff, ['Day','Date','sleep_efficiency_pct'])}\n  </table>\n</div>\n\n<div class=\"section\">\n  <h2>Total Sleep (minutes)</h2>\n  <table>\n    <tr><th>Day</th><th>Date</th><th>Total Sleep</th></tr>\n    ${tableRows(report.Total_Sleep, ['Day','Date','TotalSleep'])}\n  </table>\n</div>\n\n<div class=\"page-break\"></div>\n\n<!-- PAGE 3 -->\n<div class=\"section\">\n  <h2>Step Count</h2>\n  <table>\n    <tr><th>Day</th><th>Date</th><th>Steps</th></tr>\n    ${tableRows(report.Step_Count, ['Day','Date','StepCount'])}\n  </table>\n</div>\n\n<div class=\"section\">\n  <h2>Oxygen Saturation</h2>\n  <table>\n    <tr><th>Day</th><th>Date</th><th>Oxygen (%)</th></tr>\n    ${tableRows(report.Oxygen, ['Day','Date','Oxygen'])}\n  </table>\n</div>\n\n<div class=\"page-break\"></div>\n\n<!-- PAGE 4 -->\n<div class=\"section\">\n  <h2>Heart Rate</h2>\n  <table>\n    <tr><th>Day</th><th>Date</th><th>Avg</th><th>Min</th><th>Max</th></tr>\n    ${(report.Avg_BPM || []).map((r,i) => `\n      <tr>\n        <td>${r.Day}</td>\n        <td>${r.Date}</td>\n        <td>${r.BpmAVG}</td>\n        <td>${report.Min_BPM?.[i]?.BpmMIN ?? '—'}</td>\n        <td>${report.Max_BPM?.[i]?.BpmMAX ?? '—'}</td>\n      </tr>\n    `).join('')}\n  </table>\n</div>\n\n</body>\n</html>\n`;\n\nreturn [{ html }];\n"
      },
