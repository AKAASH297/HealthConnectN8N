        "query": "SELECT\n  CASE\n    WHEN dn.\"is_weekend\" THEN 'weekend'\n    ELSE 'weekday'\n  END AS day_type,\n  ROUND(AVG(sd.\"TotalSleep\"))::int AS avg_sleep_time\nFROM \"SLEEPDATA\" sd\nJOIN \"date_norm\" dn\n  ON sd.\"Date\" = dn.\"date\"\nWHERE dn.\"date\"\nBETWEEN to_date('{{ $json[\"\"] }}', 'YYYY-MM-DD')\n    AND to_date('{{ $json[\"\"] }}', 'YYYY-MM-DD') + INTERVAL '6 days'\nGROUP BY dn.\"is_weekend\";\n",
