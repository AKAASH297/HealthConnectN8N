    {
      "parameters": {
        "jsCode": "// Group HeartRate samples by date and compute min / max / avg\n\nconst daily = {};\n\nfor (const item of items) {\n  const record = item.json;\n  if (!Array.isArray(record.samples)) continue;\n\n  for (const s of record.samples) {\n    const bpm = s.beatsPerMinute;\n    if (typeof bpm !== 'number') continue;\n\n    const date = new Date(s.time).toISOString().split('T')[0];\n\n    if (!daily[date]) {\n      daily[date] = {\n        sum: 0,\n        count: 0,\n        min: bpm,\n        max: bpm\n      };\n    }\n\n    daily[date].sum += bpm;\n    daily[date].count += 1;\n    daily[date].min = Math.min(daily[date].min, bpm);\n    daily[date].max = Math.max(daily[date].max, bpm);\n  }\n}\n\nconst output = [];\n\nfor (const [date, d] of Object.entries(daily)) {\n  output.push({\n    json: {\n      Date: date,\n      BpmMin: d.min,\n      BpmMax: d.max,\n      BpmAvg: Math.round(d.sum / d.count)\n    }\n  });\n}\n\nreturn output;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        -128
      ],
      "id": "61359524-ca8e-456b-bd6b-57ad532adf1a",
      "name": "Normalize BPM"
    },
    {
      "parameters": {
        "jsCode": "// n8n Code node\n// Aggregates sleep per WAKE-UP DATE (fixes missing 17th)\n\nconst STAGE_MAP = {\n  1: 'AWAKE',\n  4: 'LIGHT',\n  5: 'DEEP',\n  6: 'REM'\n};\n\nconst dayMap = {};\n\n// ---- FIRST PASS: group by wake-up date ----\nfor (const item of items) {\n  const input = item.json;\n\n  if (!Array.isArray(input.stages)) continue;\n\n  for (const s of input.stages) {\n    const stageName = STAGE_MAP[s.stage];\n    if (!stageName) continue;\n\n    const start = new Date(s.startTime);\n    const end = new Date(s.endTime);\n    if (isNaN(start) || isNaN(end)) continue;\n\n    const duration = (end - start) / 60000;\n    if (duration <= 0) continue;\n\n    // ✅ USE endTime date (wake-up day)\n    const date = end.toISOString().split('T')[0];\n\n    if (!dayMap[date]) {\n      dayMap[date] = {\n        date,\n        total_sleep_minutes: 0,\n        light_minutes: 0,\n        deep_minutes: 0,\n        rem_minutes: 0,\n        awake_minutes: 0\n      };\n    }\n\n    const day = dayMap[date];\n\n    switch (stageName) {\n      case 'LIGHT':\n        day.light_minutes += duration;\n        day.total_sleep_minutes += duration;\n        break;\n\n      case 'DEEP':\n        day.deep_minutes += duration;\n        day.total_sleep_minutes += duration;\n        break;\n\n      case 'REM':\n        day.rem_minutes += duration;\n        day.total_sleep_minutes += duration;\n        break;\n\n      case 'AWAKE':\n        day.awake_minutes += duration;\n        break;\n    }\n  }\n}\n\n// ---- SECOND PASS: round + output ----\nconst output = Object.values(dayMap)\n  .sort((a, b) => a.date.localeCompare(b.date))\n  .map(d => ({\n    json: {\n      date: d.date,\n      total_sleep_minutes: Math.round(d.total_sleep_minutes),\n      light_minutes: Math.round(d.light_minutes),\n      deep_minutes: Math.round(d.deep_minutes),\n      rem_minutes: Math.round(d.rem_minutes),\n      awake_minutes: Math.round(d.awake_minutes)\n    }\n  }));\n\nreturn output;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        32
      ],
      "id": "eff2d022-b43a-4a23-ba68-91d648bc1ca1",
      "name": "Normalize Sleep"
