        "query": "SELECT\n  ROUND(\n    (\n      AVG(sm.\"sleep_efficiency_pct\") * 0.4 +\n      AVG(sd.\"TotalSleep\") / 480 * 100 * 0.3 +\n      AVG(o.\"Oxygen\") * 0.2 +\n      (100 - AVG(b.\"BpmAVG\")) * 0.1\n    )::numeric\n  )::int AS weekly_health_score\nFROM \"sleep_metrics\" sm\nJOIN \"SLEEPDATA\" sd ON sm.\"Date\" = sd.\"Date\"\nJOIN \"O2STAT\" o ON sm.\"Date\" = o.\"Date\"\nJOIN \"BPMDATA\" b ON sm.\"Date\" = b.\"Date\"\nJOIN \"date_norm\" dn ON sm.\"Date\" = dn.\"date\"\nWHERE dn.\"date\"\nBETWEEN to_date('{{ $json[\"\"] }}','YYYY-MM-DD')\n    AND to_date('{{ $json[\"\"] }}','YYYY-MM-DD') + INTERVAL '6 days';\n",
